<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Email_Format</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>AND(NOT(ISBLANK(Email__c)), NOT(CONTAINS(Email__c, '@')))</errorConditionFormula>
    <errorDisplayField>Email__c</errorDisplayField>
    <errorMessage>Enter a valid Email Address.</errorMessage>
</ValidationRule>
