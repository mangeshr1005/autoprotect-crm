<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Premium_On_Active</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, 'Active'), ISBLANK(Premium_Amount__c))</errorConditionFormula>
    <errorDisplayField>Premium_Amount__c</errorDisplayField>
    <errorMessage>Enter Premium Amount before activating the Policy.</errorMessage>
</ValidationRule>
