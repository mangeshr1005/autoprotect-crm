<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Claim_Within_Coverage</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>Claim_Amount__c &gt; Policy__r.Remaining_Coverage__c</errorConditionFormula>
    <errorDisplayField>Claim_Amount__c</errorDisplayField>
    <errorMessage>Claim Amount cannot exceed the Remaining Coverage.</errorMessage>
</ValidationRule>
