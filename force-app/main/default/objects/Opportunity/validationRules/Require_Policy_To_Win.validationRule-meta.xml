<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Policy_To_Win</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>ISPICKVAL(StageName, 'Closed Won') &amp;&amp; ISBLANK(Policy__c)</errorConditionFormula>
    <errorDisplayField>Policy__c</errorDisplayField>
    <errorMessage>Link a Policy before marking Opportunity as Closed Won.</errorMessage>
</ValidationRule>
