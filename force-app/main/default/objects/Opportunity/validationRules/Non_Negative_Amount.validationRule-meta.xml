<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Non_Negative_Amount</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>Amount &lt; 0</errorConditionFormula>
    <errorDisplayField>Amount</errorDisplayField>
    <errorMessage>Expected Premium Amount cannot be negative.</errorMessage>
</ValidationRule>
